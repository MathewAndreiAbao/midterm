# ---------------------------------------------------------------
# Firebase configuration
# ---------------------------------------------------------------
# 1. Go to https://console.firebase.google.com and create a project.
# 2. Add a Web App (</> icon) to that project.
# 3. Copy the values from the firebaseConfig object it shows you.
# 4. Copy this file to ".env" and paste your values below.
#
#    cp .env.example .env
#
# The ".env" file is git-ignored so your keys are not pushed.
# ---------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------
# Optional: local emulator mode
# ---------------------------------------------------------------
# Set this to "true" to use the local Firebase emulator instead of the real
# cloud project (useful for demoing without internet). You still need
# VITE_FIREBASE_PROJECT_ID set - any name works, e.g. demo-expense-tracker.
# Start the emulator in another terminal with:  npm run emulator
VITE_USE_FIREBASE_EMULATOR=
